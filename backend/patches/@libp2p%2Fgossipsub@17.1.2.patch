+// One counter per author: a process running several nodes (identities) must not number their messages from one
+// shared counter, or consecutive seqnos on two nodes give away that they are the same machine. Each counter starts
+// at a random point up to 2^40 ns (about 18 minutes) after the clock, so the seqno does not tell either when a node
+// started: nodes started together would otherwise be paired by their nearly equal first seqnos.
+const seqnoCounters = new Map();
+function seqnoStart() {
+    const random = crypto.getRandomValues(new Uint8Array(5));
+    let offset = 0n;
+    for (const byte of random)
+        offset = (offset << 8n) | BigInt(byte);
+    return BigInt(Date.now()) * 1000000n + offset;
+}
