# Force LF line endings for shell scripts (even on Windows checkouts)
# This prevents CRLF issues when running scripts inside Docker/Linux
*.sh text eol=lf
# Apple's codesign entitlement parser rejects CRLF.
*.plist text eol=lf
# Match Prettier's endOfLine setting on every checkout.
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.svelte text eol=lf
*.html text eol=lf
*.css text eol=lf
*.bat -text whitespace=cr-at-eol
